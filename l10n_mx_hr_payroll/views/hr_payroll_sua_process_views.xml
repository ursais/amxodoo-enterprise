<odoo>

    <record id="view_hr_payroll_sua_reports_form" model="ir.ui.view">
        <field name="name">hr.payroll.sua.reports.form</field>
        <field name="model">hr.payroll.sua.reports</field>
        <field name="arch" type="xml">
            <form string="Payroll SUA Reports">
                <header>
                    <button
                        string="Cancel"
                        name="sua_cancel"
                        states="calculated"
                        type="object"
                    />
                    <button
                        string="Calculate"
                        name="sua_calculate"
                        class="oe_highlight"
                        states="draft"
                        type="object"
                    />
                    <button
                        string="SUA (txt)"
                        name="sua_txt"
                        class="oe_highlight"
                        states="calculated"
                        type="object"
                    />
                    <button
                        string="Affiliation TXT"
                        name="affiliation_txt"
                        class="oe_highlight"
                        states="calculated"
                        type="object"
                        attrs="{'invisible': [('report_type', '!=', 'alta')]}"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="report_type" />
                            <field
                                name="movt_type"
                                attrs="{'invisible':[('report_type','!=','movt')]}"
                            />
                        </group>
                        <group>
                            <label for="date_start" string="Period" />
                            <span>
                                <field name="date_start" class="oe_inline" /> - <field
                                    name="date_end"
                                    class="oe_inline"
                                />
                            </span>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employees">
                            <field name="line_ids">
                                <tree>
                                    <field name="date" />
                                    <field name="name" />

                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="hr_payroll_sua_reports_tree" model="ir.ui.view">
        <field name="name">hr.payroll.sua.reports.tree</field>
        <field name="model">hr.payroll.sua.reports</field>
        <field name="arch" type="xml">
            <tree sample="1">
                <field name="name" />
                <field name="date_start" />
                <field name="date_end" />
                <field
                    name="state"
                    widget="badge"
                    decoration-danger="state == 'cancel'"
                    decoration-muted="state == 'draft'"
                    decoration-success="state == 'done'"
                />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="hr_payroll_sua_reports" model="ir.actions.act_window">
        <field name="name">SUA Reports</field>
        <field name="res_model">hr.payroll.sua.reports</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="hr_payroll_sua_lines_reports_tree" model="ir.ui.view">
        <field name="name">hr.payroll.sua.reports.line.tree</field>
        <field name="model">hr.payroll.sua.reports.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date" />
                <field name="name" />
                <field name="ssnid" />
            </tree>
        </field>
    </record>

</odoo>
