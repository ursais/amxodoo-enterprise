<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_edi_addenda_kuehne_nagel" model="l10n_mx_edi.addenda">
        <field name="name">Addenda Kuehne Nagel</field>
        <field name="arch" type="xml">
            <t>
                <t t-xml-node="comprobante">
                    <t t-namespace-key="kn" t-namespace-url="http://www.w3.org/2001/XMLSchema"/>
                </t>
                <t t-xml-node="addenda" xmlns:kn="http://www.w3.org/2001/XMLSchema">
                    <kn:KNRECEPCION>
                        <kn:Tipo>
                            <kn:FacturasKN>
                                <kn:Purchase_Order t-out="record.ref or None" />
                                <kn:FileNumber_GL
                                    t-out="record.kn_file_number_gl or None"
                                />
                                <kn:Branch_Centre
                                    t-out="record.kn_branch_centre or None"
                                />
                                <kn:TransportRef
                                    t-out="record.kn_transport_ref or None"
                                />
                            </kn:FacturasKN>
                        </kn:Tipo>
                    </kn:KNRECEPCION>
                </t>
            </t>
        </field>
    </record>
</odoo>
